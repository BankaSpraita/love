<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>госпожа</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400&display=swap" rel="stylesheet">
<style>
  :root {
    --white: #ffffff;
    --snow: #fbfbf9;
    --mist: #eeece7;
    --sage: #8aa191;
    --sage-deep: #61796a;
    --ink: #4d4842;
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --sans: "Jost", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--white);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 300;
    line-height: 1.75;
    overflow-x: hidden;
  }

  /* Hero: bouquet melts into the white page */
  .hero { position: relative; max-width: 640px; margin: 0 auto; }
  .hero img { width: 100%; height: min(86vh, 760px); object-fit: cover; object-position: 50% 40%; display: block; animation: bloom 1.8s ease-out both; }
  .hero::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 42%;
    background: linear-gradient(to bottom, rgba(255,255,255,0), var(--white) 92%);
  }
  .hero h1 {
    position: absolute; left: 0; right: 0; bottom: 18px; z-index: 2;
    text-align: center;
    font-family: var(--serif); font-weight: 400; font-style: italic;
    font-size: clamp(3.4rem, 15vw, 5.6rem); line-height: 1;
    letter-spacing: 0.02em;
  }
  @keyframes bloom { from { opacity: 0; transform: scale(1.03); } to { opacity: 1; transform: scale(1); } }

  section { max-width: 520px; margin: 0 auto; padding: 48px 28px; text-align: center; }

  .words p { font-size: 1.08rem; max-width: 38ch; margin: 0 auto 22px; }
  .words .big {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.9rem, 6.5vw, 2.5rem); line-height: 1.3; margin: 34px auto;
  }
  .stem { width: 1px; height: 70px; margin: 36px auto 0; background: linear-gradient(var(--sage), rgba(255,255,255,0)); }

  /* Question */
  .ask { min-height: 88vh; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  h2 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.4rem, 9vw, 3.6rem); line-height: 1.15; margin-bottom: 44px;
  }
  .buttons { display: flex; gap: 20px; justify-content: center; align-items: center; flex-wrap: wrap; }
  button {
    font-family: var(--sans); font-size: 1.05rem; font-weight: 400;
    padding: 14px 46px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--sage);
    transition: background 0.25s, box-shadow 0.25s;
  }
  button:focus-visible { outline: 2px solid var(--sage-deep); outline-offset: 3px; }
  #yes { background: var(--sage); color: var(--white); }
  #yes:hover { background: var(--sage-deep); box-shadow: 0 8px 24px rgba(97, 121, 106, 0.28); }
  .slot { display: inline-block; }
  #no { background: var(--white); color: var(--sage-deep); }
  #no.free {
    position: fixed; z-index: 10;
    transition: left 0.35s cubic-bezier(.3,1.4,.5,1), top 0.35s cubic-bezier(.3,1.4,.5,1);
  }

  /* Ending */
  #after { display: none; }
  #after.show { display: block; animation: bloom 1.2s ease-out both; }
  .yes-line { font-family: var(--serif); font-style: italic; font-size: clamp(1.8rem, 6vw, 2.5rem); line-height: 1.25; margin-bottom: 34px; }
  .heart { width: min(150px, 40vw); display: block; margin: 0 auto 26px; filter: drop-shadow(0 14px 22px rgba(0,0,0,0.18)); }
  .caption { font-family: var(--serif); font-size: 1.55rem; font-style: italic; padding-bottom: 40px; }

  /* Qualities */
  .qualities { display: none; padding-top: 24px; padding-bottom: 90px; }
  .qualities.show { display: block; animation: bloom 1.2s ease-out both; }
  .qualities h3 { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 2.4rem; margin-bottom: 22px; }
  .qualities ul { list-style: none; padding: 0; }
  .qualities li { font-family: var(--serif); font-size: 1.55rem; line-height: 1.5; padding: 7px 0; }
  .qualities li:last-child { font-style: italic; font-size: 1.9rem; padding-top: 22px; }

  /* Petals */
  .petal {
    position: fixed; top: -30px; z-index: 5; pointer-events: none;
    width: 14px; height: 18px; background: var(--white);
    border-radius: 80% 0 80% 0; box-shadow: 0 0 0 1px var(--mist);
    animation: fall linear forwards;
  }
  @keyframes fall { to { transform: translate(var(--drift), 108vh) rotate(var(--spin)); } }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .hero img, #after.show, .qualities.show { animation: none; }
    #no.free { transition: none; }
    .petal { display: none; }
  }
</style>
</head>
<body>

<div class="hero">
  <img src="data:image/jpeg;base64," alt="Белый букет">
  <h1>госпожа</h1>
</div>

<section class="words">
  <p>Я долго думал, как сказать это красиво, а потом понял, что красиво не нужно. Нужно честно.</p>
  <p class="big">Ты мне нравишься.<br>Очень.</p>
  <p class="big">Я тебя люблю.</p>
  <p>Теперь у меня остался только один вопрос, и я буду ждать твоего ответа сколько нужно.</p>
  <div class="stem"></div>
</section>

<section class="ask" id="ask">
  <h2>Давайте<br>встречаться?</h2>
  <div class="buttons" id="buttons">
    <button id="yes" type="button">Да</button>
    <span class="slot" id="slot"><button id="no" type="button">Нет</button></span>
  </div>
</section>

<section id="after">
  <p class="yes-line">Я знал, что ты скажешь «да».</p>
  <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="Чёрное сердце">
    <path fill="#000" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
  </svg>
  <p class="caption">жду вас в чате</p>
</section>

<section class="qualities" id="qualities">
  <h3>вы:</h3>
  <ul>
    <li>красивая</li>
    <li>заботливая</li>
    <li>умная</li>
    <li>нежная</li>
    <li>добрая</li>
    <li>искренняя</li>
    <li>тёплая</li>
    <li>весёлая</li>
    <li>мудрая</li>
    <li>обаятельная</li>
    <li>стильная</li>
    <li>внимательная</li>
    <li>сильная</li>
    <li>настоящая</li>
    <li>милая</li>
    <li>любимая</li>
    <li>чуткая</li>
    <li>терпеливая</li>
    <li>грациозная</li>
    <li>понимающая</li>
    <li>светлая</li>
    <li>отзывчивая</li>
    <li>загадочная</li>
    <li>уютная</li>
    <li>самодостаточная</li>
    <li>целеустремлённая</li>
    <li>женственная</li>
    <li>душевная</li>
    <li>лёгкая</li>
    <li>вдохновляющая</li>
    <li>честная</li>
    <li>щедрая</li>
    <li>скромная</li>
    <li>смелая</li>
    <li>творческая</li>
    <li>неповторимая</li>
    <li>мечтательная</li>
    <li>ласковая</li>
    <li>открытая</li>
    <li>трогательная</li>
    <li>надёжная</li>
    <li>интересная</li>
    <li>остроумная</li>
    <li>благородная</li>
    <li>жизнерадостная</li>
    <li>аккуратная</li>
    <li>естественная</li>
    <li>притягательная</li>
    <li>особенная</li>
    <li>самая лучшая</li>
  </ul>
</section>

<script>
  const yes = document.getElementById('yes');
  const no = document.getElementById('no');
  const slot = document.getElementById('slot');
  const after = document.getElementById('after');
  const askBlock = document.getElementById('ask');

  function dodge(e) {
    if (e && e.cancelable) e.preventDefault();
    if (!no.classList.contains('free')) {
      const r = no.getBoundingClientRect();
      slot.style.width = r.width + 'px';
      slot.style.height = r.height + 'px';
      no.style.left = r.left + 'px';
      no.style.top = r.top + 'px';
      no.classList.add('free');
      void no.offsetWidth;
    }
    const pad = 14;
    const w = no.offsetWidth, h = no.offsetHeight;
    const y = yes.getBoundingClientRect();
    let x, t, tries = 0;
    do {
      x = pad + Math.random() * (window.innerWidth - w - pad * 2);
      t = pad + Math.random() * (window.innerHeight - h - pad * 2);
      tries++;
    } while (
      tries < 40 &&
      x < y.right + 30 && x + w > y.left - 30 &&
      t < y.bottom + 30 && t + h > y.top - 30
    );
    no.style.left = Math.max(pad, x) + 'px';
    no.style.top = Math.max(pad, t) + 'px';
  }

  ['pointerenter', 'pointerdown', 'touchstart', 'click', 'focus'].forEach(ev =>
    no.addEventListener(ev, dodge, { passive: false })
  );

  const qualities = document.getElementById('qualities');
  let autoScrolling = false;

  function stopAuto() { autoScrolling = false; }

  function autoScroll() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    after.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (reduce) return;

    // after the first glide, keep drifting down slowly through the list
    setTimeout(() => {
      autoScrolling = true;
      let pos = window.scrollY;
      let last = performance.now();
      const speed = 38; // pixels per second
      ['wheel', 'touchstart', 'mousedown', 'keydown'].forEach(ev =>
        window.addEventListener(ev, stopAuto, { once: true, passive: true })
      );
      function step(now) {
        if (!autoScrolling) return;
        pos += speed * (now - last) / 1000;
        last = now;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (pos >= max) { window.scrollTo({ top: max, behavior: 'instant' }); autoScrolling = false; return; }
        window.scrollTo({ top: pos, behavior: 'instant' });
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }, 2200);
  }

  yes.addEventListener('click', () => {
    document.getElementById('buttons').style.display = 'none';
    no.style.display = 'none';
    askBlock.querySelector('h2').textContent = 'Спасибо, госпожа 🤍';
    askBlock.style.minHeight = '40vh';
    after.classList.add('show');
    qualities.classList.add('show');
    autoScroll();
    petals();
  });

  function petals() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (let i = 0; i < 36; i++) {
      const p = document.createElement('div');
      p.className = 'petal';
      p.style.left = Math.random() * 100 + 'vw';
      p.style.animationDuration = 5 + Math.random() * 5 + 's';
      p.style.animationDelay = Math.random() * 3 + 's';
      p.style.setProperty('--drift', (Math.random() * 160 - 80) + 'px');
      p.style.setProperty('--spin', (Math.random() * 720 - 360) + 'deg');
      document.body.appendChild(p);
      p.addEventListener('animationend', () => p.remove());
    }
  }
</script>
</body>
</html>
